{
  "session_dirs": [
    "/usr/share/wayland-sessions",
    "/usr/share/xsessions"
  ],
  "custom_sessions": [
    {
      "name": "Shell",
      "exec": "/usr/bin/bash"
    }
  ],
  "monitor_nums": [],
  "form_on_monitors": [0],
  "delay_secs": 1,
  "cmd-sleep": "systemctl suspend",
  "cmd-reboot": "systemctl reboot",
  "cmd-poweroff": "systemctl poweroff",
  "gtk-theme": "adw-gtk3-dark",
  "gtk-icon-theme": "Flat-Remix-Red-Dark",
  "gtk-cursor-theme": "Bibata-Modern-Classic",
  "prefer-dark-theme": true,
  "template-name": "",
  "time-format": "%H:%M",
  "date-format": "%A, %d %B %Y",
  "layer": "overlay",
  "keyboard-mode": "on_demand",
  "lang": "",
  "avatar-show": false,
  "avatar-size": 100,
  "avatar-border-width": 1,
  "avatar-border-color": "#eee",
  "avatar-corner-radius": 15,
  "avatar-circle": false,
  "play-login-sound-once": true,
  "login-sound-volume": "-10",
  "env-vars": []
}
